{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "framework": null,
  "installCommand": "composer install --no-dev --optimize-autoloader && npm install",
  "functions": {
    "api/index.php": {
      "runtime": "@vercel/php@3.0.0",
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/build/:path*", "destination": "/public/build/:path*" },
    { "source": "/assets/:path*", "destination": "/public/assets/:path*" },
    { "source": "/favicon.ico", "destination": "/public/favicon.ico" },
    { "source": "/robots.txt", "destination": "/public/robots.txt" },
    { "source": "/(.*)", "destination": "/api/index.php" }
  ],
  "headers": [
    {
      "source": "/build/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}

