{
  "version": 2,
  "builds": [
    { "src": "api/index.php", "use": "@vercel/php" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/build/(.*)", "dest": "/public/build/$1" },
    {
      "src": "/(.*\\.(?:css|js|map|png|jpg|jpeg|gif|svg|webp|ico|txt|woff2?|ttf|eot))",
      "dest": "/public/$1"
    },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}

