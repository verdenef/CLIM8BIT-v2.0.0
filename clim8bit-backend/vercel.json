{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "composer install --no-dev --optimize-autoloader && npm install",
  "framework": null,
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.3",
      "config": {
        "includeFiles": [
          "vendor/laravel/framework/src/Illuminate/Foundation/resources/exceptions/renderer/**"
        ]
      }
    },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/build/(.*)", "dest": "/public/build/$1" },
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/favicon\\.ico", "dest": "/public/favicon.ico" },
    { "src": "/robots\\.txt", "dest": "/public/robots.txt" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
