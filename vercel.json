{
  "version": 2,
  "buildCommand": "cd clim8bit-backend && npm run build",
  "installCommand": "cd clim8bit-backend && npm ci",
  "outputDirectory": "clim8bit-backend/public",
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3",
      "includeFiles": "{clim8bit-backend/composer.json,clim8bit-backend/composer.lock,clim8bit-backend/vendor/laravel/framework/src/Illuminate/Foundation/resources/**,clim8bit-backend/public/build/**}",
      "excludeFiles": "{**/node_modules/**,**/tests/**,**/.git/**,**/.github/**,**/storage/**}"
    }
  },
  "routes": [
    { "src": "/build/(.*)", "dest": "/clim8bit-backend/public/build/$1" },
    { "src": "/assets/(.*)", "dest": "/clim8bit-backend/public/assets/$1" },
    { "src": "/favicon\\.ico", "dest": "/clim8bit-backend/public/favicon.ico" },
    { "src": "/robots\\.txt", "dest": "/clim8bit-backend/public/robots.txt" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
